+#define PQ_EMR3_TH(MODE_, W_, R_, GPW_)                                                           \
+  if (tiled) { if (whs) PQ_EMR3(MODE_, W_, R_, GPW_, true, true); else PQ_EMR3(MODE_, W_, R_, GPW_, true, false); } \
