+        m = tl.program_id(0)
+        j = tl.program_id(1)
+        n = tl.load(IDX + m * R + j)
+        acc = tl.zeros((BLOCK_K,), dtype=tl.float32)
+        if FP8:
+            sc = tl.load(S + n).to(tl.float32)
+        for k0 in range(0, K, BLOCK_K):
+            offs = k0 + tl.arange(0, BLOCK_K)
+            if FP8:
