+                e = (b >> 3) & 15
+                mant = (b & 7).to(tl.float32)
+                mag = tl.where(e == 0, mant * 0.001953125,
+                               (1.0 + mant * 0.125) * tl.exp2((e - 7).to(tl.float32)))
+                wv = tl.where((b & 128) != 0, -mag, mag) * sc
